PUID=1000
PGID=1000
TZ=Asia/Ho_Chi_Minh
# Host interface for game ports. Set to a real local address (0.0.0.0 for all).
BIND_IP=0.0.0.0
GAME_PORT=7777
GAME_PORT_PLUS_1=7778
GAME_PORT_PLUS_2=7779
QUERY_PORT=27015
# Panel is private by default; access through SSH port forwarding.
PANEL_BIND_IP=127.0.0.1
WEB_PORT=8080
# Must exceed 3 * manager stopTimeoutSeconds + 30 seconds.
STOP_GRACE_PERIOD=10m
# Optional headless bootstrap; leave empty to use the one-time wizard link.
WEB_ADMIN_PASSWORD=
SESSION_SECRET=